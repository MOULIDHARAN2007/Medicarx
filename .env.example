# ==============================================================================
# MediCareX Healthcare SaaS Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local and configure your environment variables.
# (.env.local is automatically loaded with highest priority and ignored by git)
# NEVER commit real production secrets into version control.

# --- SERVER CONFIGURATION ---
PORT=8080

# --- JWT AUTHENTICATION CONFIGURATION ---
# Generate a cryptographically secure 256-bit or 512-bit random string for production
JWT_SECRET=medicarex_super_secret_jwt_hmac256_key_2026_healthcare_saas

# --- ADMIN REGISTRATION AUTHORIZATION SECRET ---
# Required during /api/auth/register when role is 'ADMIN'
ADMIN_INVITE_CODE=MEDICAREX-ADMIN-2026

# --- GOOGLE OAUTH 2.0 CONFIGURATION ---
# Obtain client credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (Application type: Web application)
# 2. Add Authorized JavaScript Origins:
#    - http://localhost:8080
#    - http://localhost
#    - https://<your-subdomain>.trycloudflare.com (when using Cloudflare Tunnel)
# 3. Add Authorized Redirect URIs:
#    - http://localhost:8080/api/auth/google/callback
#    - https://<your-subdomain>.trycloudflare.com/api/auth/google/callback (when using Cloudflare Tunnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# --- DATABASE CONFIGURATION (MySQL Production) ---
# When MySQL is reachable, MediCareX automatically connects to it.
# Otherwise, it runs on embedded SQLite (backend/medicarex.db) with WAL concurrency.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicarex
DB_USER=root
DB_PASSWORD=

# --- SMTP EMAIL DELIVERY CONFIGURATION ---
# For automated password reset & email verification delivery in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
